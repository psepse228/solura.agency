# Copy to .env and fill in. Never commit the real .env.

ENVIRONMENT=development

# Supabase (see ../supabase/README.md)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Canvas — Webster's Canvas domain (same for all members, tokens are per-member
# and live in the `members` table, not here)
CANVAS_BASE_URL=https://webster.instructure.com

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# OpenAI — for whatever earns its keep (summarizing assignments, digest text)
OPENAI_API_KEY=

# Frontend origin, for CORS
FRONTEND_URL=http://localhost:3000

# Session signing -- generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Do NOT reuse cana-ai-tutor's or any other product's secret.
SESSION_SECRET=
